# ============================================================
# Sekelas Cafe — Contoh Environment
# Salin menjadi `.env` lalu isi nilai asli:  cp .env.example .env
# JANGAN pernah commit file .env yang berisi nilai asli.
# ============================================================

# ---- Database (Prisma → Supabase PostgreSQL via Supavisor pooler) ----
# Format URL pooler Supabase (IPv4-friendly, cocok untuk serverless):
#   Pengembangan lokal / koneksi persisten  → session pooler  (port 5432)
#   Serverless (Vercel dsb.)                 → transaction pooler (port 6543)
# Pola: postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:<port>/postgres?pgbouncer=true&connection_limit=<n>
SEKELAS_DATABASE_URL=postgresql://ROLE.PROJECT_REF.PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5

# ---- Auth (JWT sesi staf, cookie httpOnly `skls_session`) ----
# Bangun secret acak yang kuat, contoh:
#   openssl rand -base64 48
AUTH_SECRET=GANTI_DENGAN_SECRET_ACAK_YANG_PANJANG

# ---- Supabase Storage (unggah foto menu & QRIS oleh admin) ----
# Diambil dari: Supabase Dashboard → Project Settings → API
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...
